<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="24dp" android:text="@string/brand" android:textColor="@color/mint"
        android:textSize="14sp" android:letterSpacing="0.12" android:textStyle="bold" />
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp" android:background="@color/panel">
        <Button android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:text="@string/home" android:textAllCaps="false" />
        <Button android:id="@+id/nav_classes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:text="@string/classes" android:textAllCaps="false" />
        <Button android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp" android:text="@string/settings" android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
